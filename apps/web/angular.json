{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "pnpm", "analytics": false },
  "projects": {
    "weekly-report-web": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"] },
          "configurations": {
            "development": { "sourceMap": true }
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "weekly-report-web:build:development" } }
      }
    }
  }
}
